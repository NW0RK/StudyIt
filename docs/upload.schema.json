{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "subject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "enum": [
            "calculator-outline",
            "code-slash-outline",
            "planet-outline",
            "book-outline",
            "flask-outline",
            "leaf-outline"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "color",
        "icon"
      ],
      "additionalProperties": false
    },
    "discussion": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "subjectId": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tags": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "question": {
          "type": "object",
          "properties": {
            "learnerName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "priorKnowledge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "interests": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            }
          },
          "required": [
            "learnerName",
            "body",
            "priorKnowledge",
            "interests"
          ],
          "additionalProperties": false
        },
        "personas": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "id",
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "replies": {
          "minItems": 1,
          "maxItems": 250,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "personaId": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "sourceIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "id",
              "parentId",
              "personaId",
              "body",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "subjectId",
        "title",
        "tags",
        "difficulty",
        "publishedAt",
        "updatedAt",
        "question",
        "personas",
        "replies",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "discussion"
  ],
  "additionalProperties": false
}